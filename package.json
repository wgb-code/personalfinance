    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0",
    "vitest-browser-react": "^2.2.0"
